---
import Base from '../layouts/Base.astro';
---

<Base
  title="Página no encontrada · Emprenddi"
  description="Esta página no existe o fue movida. Te ayudamos a encontrar lo que buscas."
>
  <section class="min-h-[70vh] flex items-center bg-gradient-to-br from-brand-50 via-white to-purple-50">
    <div class="container-narrow max-w-2xl text-center py-20">
      <!-- Big 404 -->
      <div class="text-9xl sm:text-[12rem] font-extrabold leading-none tracking-tighter">
        <span class="bg-gradient-to-r from-brand-600 via-purple-600 to-brand-600 bg-clip-text text-transparent">
          404
        </span>
      </div>

      <h1 class="mt-4 text-3xl sm:text-4xl font-extrabold text-slate-900">
        Esta página no existe
      </h1>
      <p class="mt-3 text-lg text-slate-600 max-w-md mx-auto">
        Quizás escribiste mal el enlace, o la página fue movida.
        Pero no te preocupes — te ayudamos a encontrar lo que buscas.
      </p>

      <!-- Quick links -->
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/" class="btn-primary">
          ← Volver al inicio
        </a>
        <a href="/contacto" class="btn-ghost">
          Solicitar demo
        </a>
      </div>

      <!-- Suggested pages -->
      <div class="mt-12 text-left bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
        <h2 class="text-sm font-semibold text-slate-500 uppercase tracking-wider mb-4">
          Páginas más visitadas
        </h2>
        <ul class="space-y-2">
          <li>
            <a href="/#features" class="flex items-center gap-2 text-brand-600 hover:underline font-semibold">
              <span>→</span> Funcionalidades de Emprenddi
            </a>
          </li>
          <li>
            <a href="/precios" class="flex items-center gap-2 text-brand-600 hover:underline font-semibold">
              <span>→</span> Precios: plan anual con todo incluido
            </a>
          </li>
          <li>
            <a href="/sobre-nosotros" class="flex items-center gap-2 text-brand-600 hover:underline font-semibold">
              <span>→</span> Sobre nosotros · Tecmax SAS
            </a>
          </li>
          <li>
            <a href="/contacto" class="flex items-center gap-2 text-brand-600 hover:underline font-semibold">
              <span>→</span> Contacto · WhatsApp +57 314 440 5766
            </a>
          </li>
        </ul>
      </div>

      <p class="mt-8 text-sm text-slate-500">
        Si crees que esto es un error, escríbenos a
        <a href="mailto:comercial@emprenddi.com" class="text-brand-600 font-semibold hover:underline">
          comercial@emprenddi.com
        </a>
      </p>
    </div>
  </section>
</Base>
