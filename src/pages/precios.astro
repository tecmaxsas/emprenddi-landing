---
import Base from '../layouts/Base.astro';
import PricingCard from '../components/PricingCard.astro';
import CTASection from '../components/CTASection.astro';
import FAQItem from '../components/FAQItem.astro';

const APP_URL = 'https://pos.emprenddi.com/app';

// Reemplazar precios reales cuando comercial los confirme.
const plans = [
  {
    name: 'Prueba',
    tagline: 'Para probar la plataforma 30 días',
    price: 'Gratis',
    period: '30 días',
    badge: undefined,
    highlighted: false,
    ctaLabel: 'Empezar ahora',
    ctaUrl: APP_URL + '/register',
    features: [
      '1 sede · 1 usuario',
      'POS completo + inventario',
      'Contabilidad automática (PUC colombiano)',
      'Facturación POS local (sin DIAN electrónica)',
      'Reportes básicos',
      'Sin tarjeta de crédito',
    ],
  },
  {
    name: 'Pro',
    tagline: 'Para PyMEs en crecimiento',
    price: '$149.000',
    period: '/mes',
    badge: 'Más popular',
    highlighted: true,
    ctaLabel: 'Empezar prueba gratis',
    ctaUrl: APP_URL + '/register',
    features: [
      '<strong>Hasta 3 sedes · 5 usuarios</strong>',
      'Todo de Starter +',
      '<strong>Facturación electrónica DIAN</strong>',
      'Nómina completa (liquidación + retiros)',
      'Garantías y servicio técnico',
      'Gestión de seriales',
      'POS Restaurante con KDS',
      'Reportes avanzados + exportar',
      'Portal del Contador externo',
      'Soporte prioritario por chat',
    ],
  },
  {
    name: 'Enterprise',
    tagline: 'Empresas medianas, multi-sede',
    price: 'Personalizado',
    period: '',
    badge: undefined,
    highlighted: false,
    ctaLabel: 'Agendar demo',
    ctaUrl: 'mailto:comercial@emprenddi.com',
    features: [
      '<strong>Sedes y usuarios ilimitados</strong>',
      'Todo de Pro +',
      'Migración asistida desde otro sistema',
      'Capacitación on-site',
      'Soporte dedicado · SLA garantizado',
      'Personalización de plantillas',
      'Integraciones a medida (Excel, ERP)',
      'Account manager asignado',
    ],
  },
];

const starter = {
  name: 'Starter',
  tagline: 'Para microempresas que empiezan',
  price: '$49.000',
  period: '/mes',
  badge: undefined,
  highlighted: false,
  ctaLabel: 'Empezar prueba gratis',
  ctaUrl: APP_URL + '/register',
  features: [
    '1 sede · 1 usuario',
    'POS + inventario + contabilidad',
    'Facturación POS local',
    'Reportes esenciales',
    'Soporte por correo',
  ],
};

// Showing 4 plans: prueba (free trial) + 3 paid (starter, pro, enterprise)
const allPlans = [plans[0], starter, plans[1], plans[2]];

const faqs = [
  { question: '¿Hay costos ocultos?', answer: 'No. El precio publicado es lo que pagas. Sin comisión por transacción, sin cobros por factura emitida, sin sorpresas.' },
  { question: '¿Puedo cambiar de plan?', answer: 'Sí, en cualquier momento. Si subes de plan se prorratea el cobro. Si bajas, aplica al siguiente periodo.' },
  { question: '¿Cómo se factura?', answer: 'Mensual o anual (con descuento del 15% en anual). Aceptamos transferencia, tarjeta de crédito y PSE.' },
  { question: '¿La DIAN está incluida en todos los planes?', answer: 'La <strong>facturación POS local</strong> (talonarios) está en todos los planes. La <strong>facturación electrónica DIAN</strong> (con CUFE) viene desde el plan Pro.' },
  { question: '¿Qué pasa si dejo de pagar?', answer: 'Tu cuenta se suspende pero los datos se conservan 30 días. Si vuelves a contratar, todo sigue intacto. Después de 30 días los datos se eliminan.' },
  { question: '¿Tienen descuento para varias empresas?', answer: 'Sí. Si manejas varias empresas (eres holding o contador externo), agenda una demo y armamos un paquete a medida.' },
  { question: '¿Necesito otro software además de Emprenddi?', answer: 'No. Emprenddi cubre POS, contabilidad, inventario, DIAN, nómina, compras y reportes. Es todo en uno.' },
];
---

<Base
  title="Precios · Emprenddi"
  description="Planes desde $49.000/mes. Prueba 30 días gratis sin tarjeta. Facturación DIAN incluida desde el plan Pro."
>
  <!-- Header -->
  <section class="bg-hero-gradient text-white py-16 sm:py-20">
    <div class="container-narrow text-center">
      <span class="inline-block px-3 py-1 mb-5 rounded-full bg-white/15 backdrop-blur text-xs font-bold uppercase tracking-widest border border-white/20">
        Precios transparentes
      </span>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight">
        Elige el plan<br />
        <span class="bg-gradient-to-r from-amber-300 to-pink-300 bg-clip-text text-transparent">
          que necesitas hoy
        </span>
      </h1>
      <p class="mt-5 text-lg text-white/90 max-w-2xl mx-auto">
        Empieza gratis 30 días. Sin tarjeta de crédito.
        Cambias o cancelas en cualquier momento.
      </p>
    </div>
  </section>

  <!-- Plans grid -->
  <section class="py-20">
    <div class="container-narrow">
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-5 items-start">
        {allPlans.map((p) => <PricingCard {...p} />)}
      </div>

      <p class="mt-10 text-center text-sm text-slate-500">
        Precios en pesos colombianos (COP), IVA no incluido.
        Pago mensual o anual con 15% de descuento.
      </p>
    </div>
  </section>

  <!-- Comparativa de features (tabla) -->
  <section class="py-16 bg-slate-50">
    <div class="container-narrow">
      <h2 class="section-title text-center mb-2">¿Qué incluye cada plan?</h2>
      <p class="section-subtitle text-center mb-10">Compáralos en detalle</p>

      <div class="overflow-x-auto rounded-2xl bg-white border border-slate-200 shadow-sm">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-slate-100">
              <th class="text-left p-4 font-bold text-slate-900">Característica</th>
              <th class="p-4 font-bold text-slate-700 text-center">Prueba</th>
              <th class="p-4 font-bold text-slate-700 text-center">Starter</th>
              <th class="p-4 font-bold text-brand-700 text-center">Pro</th>
              <th class="p-4 font-bold text-slate-700 text-center">Enterprise</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {[
              ['Sedes', '1', '1', '3', 'Ilimitadas'],
              ['Usuarios', '1', '1', '5', 'Ilimitados'],
              ['POS retail', '✓', '✓', '✓', '✓'],
              ['POS Restaurante (mesas, KDS)', '—', '—', '✓', '✓'],
              ['Inventario y kardex', '✓', '✓', '✓', '✓'],
              ['Contabilidad automática', '✓', '✓', '✓', '✓'],
              ['Plan de Cuentas DIAN', '✓', '✓', '✓', '✓'],
              ['Facturación POS local', '✓', '✓', '✓', '✓'],
              ['Facturación electrónica DIAN', '—', '—', '✓', '✓'],
              ['Nómina y empleados', '—', '—', '✓', '✓'],
              ['Garantías y servicio técnico', '—', '—', '✓', '✓'],
              ['Gestión de seriales', '—', '—', '✓', '✓'],
              ['Reportes avanzados', '—', '—', '✓', '✓'],
              ['Portal del Contador externo', '—', '—', '✓', '✓'],
              ['Soporte', 'Email', 'Email', 'Chat prioritario', 'Dedicado + SLA'],
              ['Migración desde otro sistema', '—', '—', '—', '✓'],
              ['Capacitación on-site', '—', '—', '—', '✓'],
            ].map(([feat, p, s, pr, e]) => (
              <tr class="hover:bg-slate-50">
                <td class="p-4 font-medium text-slate-900">{feat}</td>
                <td class="p-4 text-center text-slate-600">{p}</td>
                <td class="p-4 text-center text-slate-600">{s}</td>
                <td class="p-4 text-center text-brand-700 font-semibold bg-brand-50/50">{pr}</td>
                <td class="p-4 text-center text-slate-600">{e}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20">
    <div class="container-narrow max-w-3xl">
      <h2 class="section-title text-center mb-10">Preguntas sobre precios</h2>
      <div>
        {faqs.map((f) => <FAQItem question={f.question} answer={f.answer} />)}
      </div>
    </div>
  </section>

  <CTASection />
</Base>
