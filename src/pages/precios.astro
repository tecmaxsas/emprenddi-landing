---
import Base from '../layouts/Base.astro';
import CTASection from '../components/CTASection.astro';
import FAQItem from '../components/FAQItem.astro';

// Plan único anual — todo incluido.
const features = [
  {
    group: 'Operación diaria',
    items: [
      'POS retail con pantalla táctil y lector de barras',
      'POS Restaurante con mesas, cocina (KDS) y modificadores',
      'Cotizaciones, remisiones y pedidos',
      'Caja con apertura y cierre por turno',
    ],
  },
  {
    group: 'Inventario',
    items: [
      'Stock en tiempo real por sede o bodega',
      'Promedio ponderado automático',
      'Ajustes, transferencias y aperturas',
      'Alertas de stock bajo',
      'Gestión por número de serie (electrónica)',
    ],
  },
  {
    group: 'Contabilidad',
    items: [
      'Plan de Cuentas colombiano (PUC) preconfigurado',
      'Asientos automáticos en cada venta, compra y pago',
      'Libros oficiales: Diario, Mayor, Auxiliar, Balance',
      'Cierre de mes con bloqueo de ediciones',
      'Conciliación bancaria',
      'Centros de costo',
    ],
  },
  {
    group: 'DIAN',
    items: [
      'Factura electrónica DIAN',
      'Notas crédito y débito electrónicas',
      'Documento equivalente POS (talonarios)',
      'Documento soporte (compras a no responsables IVA)',
      'Información exógena anual',
      'Retenciones (fuente, IVA, ICA)',
    ],
  },
  {
    group: 'Compras y proveedores',
    items: [
      'Factura de compra + asiento automático',
      'Pagos parciales o totales',
      'Cuentas por pagar con alertas',
      'Devoluciones a proveedor',
    ],
  },
  {
    group: 'Nómina y empleados',
    items: [
      'Contratos: indefinido, fijo, obra labor, aprendizaje',
      'Parámetros legales vigentes (SMLMV, UVT)',
      'Liquidación quincenal o mensual',
      'Liquidación de retiro con cesantías y prima',
    ],
  },
  {
    group: 'Servicio técnico (garantías)',
    items: [
      'Tickets RMA con tracking de estados',
      'Asignación de técnico interno',
      'Comprobante imprimible de recepción',
      'Vencimiento de garantía calculado automáticamente',
    ],
  },
  {
    group: 'Multi-sede y usuarios',
    items: [
      '<strong>Sedes ilimitadas</strong>',
      '<strong>Usuarios ilimitados</strong>',
      'Roles predefinidos: admin, gerente, contador, cajero, vendedor',
      'Portal del Contador externo',
    ],
  },
  {
    group: 'Implementación y soporte',
    items: [
      'Sesión de configuración inicial (2 horas)',
      'Sesión de capacitación al equipo (2 horas)',
      'Migración de saldos contables iniciales',
      'Soporte por chat y correo',
      'Actualizaciones continuas sin costo extra',
    ],
  },
];

const faqs = [
  { question: '¿Por qué un solo plan?', answer: 'Porque tu negocio necesita todas las funcionalidades para operar correctamente: contabilidad, facturación, inventario, nómina y POS no se pueden separar sin romper la lógica integrada. Un plan único con todo incluido evita confusiones, sobrecostos y limitaciones artificiales.' },
  { question: '¿Hay costos ocultos?', answer: 'No. El precio publicado es lo que pagas. Sin comisión por factura emitida, sin cobros por transacción, sin sorpresas. La implementación y capacitación inicial están incluidas en el plan. Lo único que se cotiza aparte es la migración asistida desde otro sistema contable, si aplica.' },
  { question: '¿Por qué pago anual?', answer: 'El modelo anual nos permite acompañarte a profundidad: configuración, capacitación y soporte a lo largo del año. Además te aseguramos el precio durante 12 meses sin variaciones.' },
  { question: '¿Cómo se paga?', answer: 'Transferencia bancaria, PSE o tarjeta de crédito. Emitimos factura electrónica DIAN. Si necesitas crédito o pago en cuotas, conversémoslo en la demo.' },
  { question: '¿Qué pasa al final del año?', answer: 'Renuevas la suscripción y sigues operando sin interrupción. Si no renuevas, tus datos quedan en pausa 30 días por si decides reactivar; después se eliminan permanentemente.' },
  { question: '¿Puedo migrar desde otro sistema?', answer: 'Sí. Cargamos los saldos contables iniciales y el inventario inicial sin que pierdas la continuidad de tu información. La capacitación incluye el proceso completo de migración.' },
  { question: '¿Necesito otro software además de Emprenddi?', answer: 'No. Emprenddi cubre POS, contabilidad, inventario, DIAN, nómina, compras, garantías y reportes. Es todo en uno.' },
  { question: '¿Hay descuento para varias empresas?', answer: 'Sí. Si manejas varias empresas (holding, grupo de tiendas o eres contador externo), agenda una demo y armamos un paquete a medida.' },
];
---

<Base
  title="Precios · Emprenddi"
  description="Un solo plan anual con todo incluido. Sin sorpresas. Implementación, capacitación y soporte sin costo extra."
>
  <!-- Header -->
  <section class="bg-hero-gradient text-white py-16 sm:py-20">
    <div class="container-narrow text-center">
      <span class="inline-block px-3 py-1 mb-5 rounded-full bg-white/15 backdrop-blur text-xs font-bold uppercase tracking-widest border border-white/20">
        Precio transparente
      </span>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight">
        Un solo plan,<br />
        <span class="bg-gradient-to-r from-amber-300 to-pink-300 bg-clip-text text-transparent">
          todo lo que necesitas
        </span>
      </h1>
      <p class="mt-5 text-lg text-white/90 max-w-2xl mx-auto">
        Sin escalones, sin límites artificiales. Todas las funcionalidades
        para que tu negocio opere completo desde el día uno.
      </p>
    </div>
  </section>

  <!-- Single plan card -->
  <section class="py-16 sm:py-20 -mt-12">
    <div class="container-narrow max-w-3xl">
      <div class="relative rounded-3xl bg-white shadow-2xl border-2 border-brand-100 overflow-hidden">
        <!-- Top stripe -->
        <div class="absolute top-0 inset-x-0 h-2 bg-gradient-to-r from-brand-600 via-purple-600 to-brand-600"></div>

        <div class="p-8 sm:p-12">
          <!-- Plan header -->
          <div class="text-center">
            <span class="inline-block px-4 py-1.5 mb-4 rounded-full bg-gradient-to-r from-brand-600 to-purple-600 text-white text-xs font-bold uppercase tracking-widest">
              Plan Anual · Todo incluido
            </span>
            <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 mb-2">Emprenddi</h2>
            <p class="text-slate-600">La plataforma completa para tu negocio en Colombia</p>
          </div>

          <!-- Price -->
          <div class="text-center my-8 py-6 border-y border-slate-100">
            <div class="flex items-baseline justify-center gap-2">
              <span class="text-5xl sm:text-6xl font-extrabold bg-gradient-to-r from-brand-600 to-purple-600 bg-clip-text text-transparent">
                $1.600.000
              </span>
              <span class="text-lg text-slate-500 font-medium">COP / año</span>
            </div>
            <p class="text-sm text-slate-500 mt-2">
              Equivale a <strong class="text-slate-700">$133.333 / mes</strong> · IVA no incluido
            </p>
          </div>

          <!-- CTA -->
          <div class="flex flex-col sm:flex-row gap-3 justify-center mb-8">
            <a href="/contacto" class="inline-flex items-center justify-center gap-2 px-8 py-4 rounded-full bg-brand-600 hover:bg-brand-700 text-white font-bold shadow-lg shadow-brand-600/30 transition">
              Solicitar demo
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
              </svg>
            </a>
            <a href="mailto:comercial@emprenddi.com" class="btn-ghost justify-center">
              Escríbenos
            </a>
          </div>

          <p class="text-center text-xs text-slate-500">
            Después de la demo coordinamos contratación, configuración y capacitación.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Lo que incluye - grouped checklist -->
  <section class="py-16 bg-slate-50">
    <div class="container-narrow">
      <div class="text-center mb-12">
        <h2 class="section-title">Todo lo que incluye</h2>
        <p class="section-subtitle">
          Sin diferenciar planes. Tu equipo accede a la plataforma completa.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {features.map((group) => (
          <div class="p-6 rounded-2xl bg-white border border-slate-200 hover:shadow-md transition">
            <h3 class="text-base font-bold text-brand-700 mb-4 pb-3 border-b border-slate-100">
              {group.group}
            </h3>
            <ul class="space-y-2.5">
              {group.items.map((item) => (
                <li class="flex items-start gap-2 text-sm text-slate-700">
                  <svg class="w-4 h-4 mt-0.5 text-emerald-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                  </svg>
                  <span set:html={item}></span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20">
    <div class="container-narrow max-w-3xl">
      <h2 class="section-title text-center mb-10">Preguntas sobre el plan</h2>
      <div>
        {faqs.map((f) => <FAQItem question={f.question} answer={f.answer} />)}
      </div>
    </div>
  </section>

  <CTASection />
</Base>
