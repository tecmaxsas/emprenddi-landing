---
import Base from '../layouts/Base.astro';

// Página de contacto. Sin backend dinámico — el form usa mailto: como
// fallback simple. Si más adelante quieres un backend (Formspree, Vercel
// Functions, etc.) reemplaza el action.
const contactos = [
  {
    icon: '📧',
    title: 'Correo',
    value: 'comercial@emprenddi.com',
    href: 'mailto:comercial@emprenddi.com',
    note: 'Te respondemos en menos de 24 horas hábiles.',
  },
  {
    icon: '💬',
    title: 'WhatsApp',
    value: '+57 314 440 5766',
    href: 'https://wa.me/573144405766?text=' + encodeURIComponent('Hola, quiero más información sobre Emprenddi.'),
    note: 'Lun–Vie de 8 a.m. a 6 p.m.',
  },
  {
    icon: '📍',
    title: 'Oficina',
    value: 'Carrera 15 #78-33, Unilago · Locales 2-255 y 2-211',
    href: 'https://maps.google.com/?q=' + encodeURIComponent('Carrera 15 #78-33 Unilago Bogotá'),
    note: 'Bogotá, Cundinamarca · Atendemos a todo Colombia de forma remota.',
  },
];
---

<Base
  title="Contacto · Emprenddi · WhatsApp +57 314 440 5766"
  description="Solicita una demo de Emprenddi o escríbenos a comercial@emprenddi.com / WhatsApp +57 314 440 5766. Oficina en Unilago, Bogotá. Atendemos a toda Colombia."
>
  <!-- Header -->
  <section class="bg-hero-gradient text-white py-16 sm:py-20">
    <div class="container-narrow text-center">
      <span class="inline-block px-3 py-1 mb-5 rounded-full bg-white/15 backdrop-blur text-xs font-bold uppercase tracking-widest border border-white/20">
        Contáctanos
      </span>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight">
        Hablemos de tu<br />
        <span class="bg-gradient-to-r from-amber-300 to-pink-300 bg-clip-text text-transparent">
          negocio
        </span>
      </h1>
      <p class="mt-5 text-lg text-white/90 max-w-2xl mx-auto">
        Solicita una demo personalizada, resuelve dudas o
        cuéntanos qué necesitas. Estamos para ayudarte.
      </p>
    </div>
  </section>

  <!-- Datos de contacto + Form -->
  <section class="py-16 sm:py-20">
    <div class="container-narrow">
      <div class="grid lg:grid-cols-2 gap-10">

        <!-- Datos -->
        <div>
          <h2 class="text-2xl font-extrabold text-slate-900 mb-2">Canales de contacto</h2>
          <p class="text-slate-600 mb-8">
            Elige el que mejor te funcione. Para una demo personalizada
            recomendamos el correo o el formulario.
          </p>

          <div class="space-y-5">
            {contactos.map(({ icon, title, value, href, note }) => (
              <div class="p-5 rounded-2xl bg-white border border-slate-200 hover:border-brand-300 transition">
                <div class="flex items-start gap-4">
                  <div class="text-3xl">{icon}</div>
                  <div class="flex-1 min-w-0">
                    <h3 class="text-sm font-semibold text-slate-500 uppercase tracking-wider mb-1">{title}</h3>
                    {href ? (
                      <a href={href} class="text-lg font-bold text-brand-600 hover:underline break-all">{value}</a>
                    ) : (
                      <div class="text-lg font-bold text-slate-900">{value}</div>
                    )}
                    <p class="text-xs text-slate-500 mt-1">{note}</p>
                  </div>
                </div>
              </div>
            ))}
          </div>

          <!-- Horarios -->
          <div class="mt-8 p-5 rounded-2xl bg-brand-50 border border-brand-100">
            <h3 class="font-bold text-brand-900 mb-2">🕐 Horario de atención</h3>
            <p class="text-sm text-brand-800">
              Lunes a Viernes · 8:00 a.m. – 6:00 p.m. · Hora Colombia (UTC-5)
            </p>
          </div>
        </div>

        <!-- Formulario -->
        <div>
          <h2 class="text-2xl font-extrabold text-slate-900 mb-2">Envíanos un mensaje</h2>
          <p class="text-slate-600 mb-8">
            Cuéntanos sobre tu negocio para preparar una demo que se
            adapte a lo que necesitas.
          </p>

          <form
            action="mailto:comercial@emprenddi.com"
            method="post"
            enctype="text/plain"
            class="space-y-4"
          >
            <div>
              <label for="name" class="block text-sm font-semibold text-slate-700 mb-1.5">Nombre completo *</label>
              <input
                type="text"
                id="name"
                name="Nombre"
                required
                placeholder="Tu nombre"
                class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:border-brand-500 focus:ring-2 focus:ring-brand-200 outline-none transition"
              />
            </div>

            <div>
              <label for="empresa" class="block text-sm font-semibold text-slate-700 mb-1.5">Empresa</label>
              <input
                type="text"
                id="empresa"
                name="Empresa"
                placeholder="Razón social o nombre comercial"
                class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:border-brand-500 focus:ring-2 focus:ring-brand-200 outline-none transition"
              />
            </div>

            <div class="grid sm:grid-cols-2 gap-4">
              <div>
                <label for="email" class="block text-sm font-semibold text-slate-700 mb-1.5">Correo *</label>
                <input
                  type="email"
                  id="email"
                  name="Correo"
                  required
                  placeholder="tu@correo.com"
                  class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:border-brand-500 focus:ring-2 focus:ring-brand-200 outline-none transition"
                />
              </div>
              <div>
                <label for="telefono" class="block text-sm font-semibold text-slate-700 mb-1.5">Teléfono</label>
                <input
                  type="tel"
                  id="telefono"
                  name="Telefono"
                  placeholder="+57 300 000 0000"
                  class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:border-brand-500 focus:ring-2 focus:ring-brand-200 outline-none transition"
                />
              </div>
            </div>

            <div>
              <label for="tipo" class="block text-sm font-semibold text-slate-700 mb-1.5">Tipo de negocio</label>
              <select
                id="tipo"
                name="TipoNegocio"
                class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:border-brand-500 focus:ring-2 focus:ring-brand-200 outline-none transition bg-white"
              >
                <option value="">Selecciona una opción</option>
                <option>Tienda / minimarket</option>
                <option>Restaurante / cafetería</option>
                <option>Tienda de electrónica</option>
                <option>Tienda de ropa o calzado</option>
                <option>Distribuidora</option>
                <option>Taller / servicio técnico</option>
                <option>Otro</option>
              </select>
            </div>

            <div>
              <label for="mensaje" class="block text-sm font-semibold text-slate-700 mb-1.5">Cuéntanos qué necesitas</label>
              <textarea
                id="mensaje"
                name="Mensaje"
                rows="4"
                placeholder="Sobre tu negocio, qué buscas resolver, cuántas sedes, etc."
                class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:border-brand-500 focus:ring-2 focus:ring-brand-200 outline-none transition resize-none"
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full px-6 py-3.5 rounded-full bg-brand-600 hover:bg-brand-700 text-white font-bold text-base shadow-lg shadow-brand-600/30 transition"
            >
              Enviar mensaje
            </button>

            <p class="text-xs text-slate-500 text-center mt-2">
              Al enviar aceptas nuestra
              <a href="/privacidad" class="text-brand-600 hover:underline">política de privacidad</a>.
            </p>
          </form>
        </div>
      </div>
    </div>
  </section>
</Base>
