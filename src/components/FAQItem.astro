---
interface Props {
  question: string;
  answer: string;
}

const { question, answer } = Astro.props;
---

<details class="group border-b border-slate-200 py-5">
  <summary class="flex items-center justify-between cursor-pointer list-none gap-4">
    <span class="text-base sm:text-lg font-semibold text-slate-900">{question}</span>
    <svg class="w-5 h-5 text-brand-600 flex-shrink-0 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
    </svg>
  </summary>
  <p class="mt-3 text-slate-600 leading-relaxed" set:html={answer}></p>
</details>
