---
const APP_URL = 'https://pos.emprenddi.com/app';
const navLinks = [
  { href: '/#features', label: 'Funcionalidades' },
  { href: '/restaurantes', label: 'Restaurantes' },
  { href: '/precios', label: 'Precios' },
  { href: '/docs/', label: 'Documentación' },
  { href: '/blog', label: 'Blog' },
  { href: '/contacto', label: 'Contacto' },
];
---

<header class="sticky top-0 z-50 bg-white/85 backdrop-blur-md border-b border-slate-200/60">
  <nav class="container-narrow flex items-center justify-between h-16">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2" aria-label="Inicio Emprenddi">
      <img src="/logos/logo_emprenddi.svg" alt="Emprenddi" class="h-9 w-auto" />
    </a>

    <!-- Links desktop -->
    <ul class="hidden md:flex items-center gap-1 list-none m-0 p-0">
      {navLinks.map(({ href, label }) => (
        <li class="list-none">
          <a
            href={href}
            class="px-4 py-2 text-sm font-medium text-slate-700 hover:text-brand-600 transition"
          >
            {label}
          </a>
        </li>
      ))}
    </ul>

    <!-- CTAs -->
    <div class="flex items-center gap-2">
      <a
        href={APP_URL + '/login'}
        class="hidden sm:inline-flex px-4 py-2 text-sm font-semibold text-slate-700 hover:text-brand-600 transition"
      >
        Iniciar sesión
      </a>
      <a
        href="/contacto"
        class="inline-flex items-center gap-1 px-5 py-2 rounded-full bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold shadow-md shadow-brand-600/20 transition"
      >
        Solicitar demo
      </a>

      <!-- Mobile menu button -->
      <button
        type="button"
        class="md:hidden p-2 text-slate-700"
        aria-label="Abrir menú"
        onclick="document.getElementById('mobile-menu')?.classList.toggle('hidden')"
      >
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-slate-200 bg-white">
    <ul class="container-narrow py-3 flex flex-col gap-1 list-none m-0 p-0">
      {navLinks.map(({ href, label }) => (
        <li class="list-none">
          <a
            href={href}
            class="block px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100 rounded-md"
          >
            {label}
          </a>
        </li>
      ))}
      <li class="list-none pt-2 mt-1 border-t border-slate-100">
        <a
          href={APP_URL + '/login'}
          class="block px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100 rounded-md"
        >
          Iniciar sesión
        </a>
      </li>
    </ul>
  </div>
</header>
