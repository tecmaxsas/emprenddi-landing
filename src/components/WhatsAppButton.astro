---
// Botón flotante de WhatsApp presente en todas las páginas.
// Incluido desde Base.astro para que aparezca en todo el sitio.
const PHONE = '573144405766';
const MESSAGE = encodeURIComponent('Hola, quiero más información sobre Emprenddi.');
const WHATSAPP_URL = `https://wa.me/${PHONE}?text=${MESSAGE}`;
---

<a
  href={WHATSAPP_URL}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Contactar por WhatsApp"
  class="whatsapp-floating"
>
  <svg class="whatsapp-icon" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true">
    <path d="M16.001 0C7.165 0 .003 7.163.003 16c0 2.823.737 5.585 2.137 8.012L.001 32l8.181-2.143A15.92 15.92 0 0 0 16.001 32C24.838 32 32 24.837 32 16S24.838 0 16.001 0zm0 29.336a13.31 13.31 0 0 1-6.79-1.857l-.487-.289-5.06 1.327 1.351-4.93-.317-.504A13.288 13.288 0 0 1 2.665 16C2.665 8.633 8.634 2.665 16.001 2.665S29.337 8.633 29.337 16c0 7.367-5.969 13.336-13.336 13.336zm7.319-9.985c-.401-.2-2.372-1.169-2.74-1.303-.367-.134-.634-.2-.901.2-.267.401-1.034 1.302-1.268 1.569-.234.267-.467.301-.868.1-.401-.2-1.692-.624-3.224-1.989-1.192-1.063-1.995-2.376-2.229-2.777-.234-.401-.025-.617.175-.817.18-.18.401-.467.601-.7.2-.234.267-.401.401-.668.134-.267.067-.501-.033-.701-.1-.2-.901-2.174-1.235-2.978-.325-.782-.656-.677-.901-.689-.234-.012-.501-.014-.768-.014a1.47 1.47 0 0 0-1.069.501c-.367.401-1.402 1.37-1.402 3.343s1.435 3.879 1.635 4.146c.2.267 2.824 4.314 6.842 6.05.957.413 1.703.659 2.285.844.96.305 1.835.262 2.526.159.771-.115 2.372-.969 2.706-1.905.334-.937.334-1.738.234-1.905-.1-.167-.367-.267-.768-.467z"/>
  </svg>
  <span class="whatsapp-label">WhatsApp</span>
  <span class="whatsapp-pulse"></span>
</a>

<style>
  .whatsapp-floating {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 100;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 18px 12px 14px;
    background: #25D366;
    color: #ffffff;
    border-radius: 999px;
    font-family: 'Inter', system-ui, sans-serif;
    font-weight: 700;
    font-size: 14px;
    text-decoration: none;
    box-shadow: 0 4px 12px rgba(37, 211, 102, 0.4), 0 0 0 4px rgba(37, 211, 102, 0.15);
    transition: transform 200ms cubic-bezier(.22,1,.36,1),
                box-shadow 200ms,
                background 200ms;
  }
  .whatsapp-floating:hover {
    background: #1ebe5d;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(37, 211, 102, 0.5), 0 0 0 6px rgba(37, 211, 102, 0.2);
  }
  .whatsapp-floating:active {
    transform: translateY(0);
  }
  .whatsapp-icon {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
  }
  .whatsapp-label {
    line-height: 1;
  }
  /* Pulso animado para llamar la atención */
  .whatsapp-pulse {
    position: absolute;
    inset: 0;
    border-radius: 999px;
    background: #25D366;
    opacity: 0;
    z-index: -1;
    animation: wa-pulse 2.4s ease-out infinite;
  }
  @keyframes wa-pulse {
    0%   { transform: scale(1);   opacity: 0.6; }
    100% { transform: scale(1.4); opacity: 0;   }
  }
  /* En móvil compactamos: solo icono */
  @media (max-width: 640px) {
    .whatsapp-floating {
      padding: 14px;
      bottom: 16px;
      right: 16px;
    }
    .whatsapp-label {
      display: none;
    }
    .whatsapp-icon {
      width: 26px;
      height: 26px;
    }
  }
  /* Respeta usuarios que prefieren reducir animaciones */
  @media (prefers-reduced-motion: reduce) {
    .whatsapp-pulse { animation: none; }
    .whatsapp-floating { transition: none; }
  }
</style>
