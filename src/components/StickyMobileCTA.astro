---
// Barra inferior fija visible solo en móvil. Aparece tras scrollear
// para no estorbar el hero, y desaparece cuando el usuario llega al
// footer (para no taparlo). Convierte mejor que un CTA solo arriba.
---

<div
  id="sticky-mobile-cta"
  class="sticky-mobile-cta sticky-mobile-cta--hidden"
  aria-hidden="true"
>
  <div class="sticky-mobile-cta__inner">
    <div class="sticky-mobile-cta__copy">
      <div class="sticky-mobile-cta__title">¿Te interesa Emprenddi?</div>
      <div class="sticky-mobile-cta__sub">Agenda una demo en 30 segundos</div>
    </div>
    <a href="/contacto" class="sticky-mobile-cta__btn">
      Solicitar
      <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
      </svg>
    </a>
  </div>
</div>

<style>
  .sticky-mobile-cta {
    position: fixed;
    bottom: 0;
    inset-inline: 0;
    z-index: 90;
    background: #ffffff;
    border-top: 1px solid #e5e7eb;
    box-shadow: 0 -4px 12px rgba(15, 23, 42, 0.06);
    transform: translateY(0);
    transition: transform 280ms cubic-bezier(.22,1,.36,1), opacity 200ms;
  }
  .sticky-mobile-cta--hidden {
    transform: translateY(110%);
    pointer-events: none;
  }
  .sticky-mobile-cta__inner {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px 12px;
    /* WhatsApp button está en bottom-right, dejamos margen para que no se monte */
    padding-right: 84px;
  }
  .sticky-mobile-cta__copy {
    flex: 1;
    min-width: 0;
  }
  .sticky-mobile-cta__title {
    font-size: 13px;
    font-weight: 700;
    color: #0f172a;
    line-height: 1.2;
  }
  .sticky-mobile-cta__sub {
    font-size: 11.5px;
    color: #64748b;
    margin-top: 1px;
    line-height: 1.2;
  }
  .sticky-mobile-cta__btn {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 10px 16px;
    border-radius: 999px;
    background: #4f46e5;
    color: #ffffff;
    font-weight: 700;
    font-size: 13px;
    text-decoration: none;
    box-shadow: 0 4px 10px rgba(79, 70, 229, 0.35);
    transition: background 150ms;
  }
  .sticky-mobile-cta__btn:hover { background: #4338ca; }

  /* Solo en mobile */
  @media (min-width: 768px) {
    .sticky-mobile-cta { display: none; }
  }
</style>

<script is:inline>
  // Mostrar tras 400px de scroll. Ocultar al llegar al footer para
  // no tapar los links de la última sección.
  (function () {
    const cta = document.getElementById('sticky-mobile-cta');
    if (!cta) return;
    const footer = document.querySelector('footer');
    let isShown = false;

    function tick() {
      const scrolled = window.scrollY > 400;
      const nearFooter = footer && (footer.getBoundingClientRect().top < window.innerHeight - 100);
      const shouldShow = scrolled && !nearFooter;
      if (shouldShow === isShown) return;
      isShown = shouldShow;
      cta.classList.toggle('sticky-mobile-cta--hidden', !isShown);
      cta.setAttribute('aria-hidden', isShown ? 'false' : 'true');
    }

    let pending = false;
    window.addEventListener('scroll', function () {
      if (pending) return;
      pending = true;
      requestAnimationFrame(function () {
        tick();
        pending = false;
      });
    }, { passive: true });
    tick();
  })();
</script>
