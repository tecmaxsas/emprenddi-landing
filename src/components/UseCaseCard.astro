---
interface Props {
  emoji: string;
  title: string;
  client: string;
  description: string;
  quote: string;
}

const { emoji, title, client, description, quote } = Astro.props;
---

<div class="p-7 rounded-2xl bg-gradient-to-br from-brand-50 via-white to-purple-50 border border-brand-100 hover:shadow-xl transition-all duration-300">
  <div class="flex items-start gap-4 mb-4">
    <div class="text-4xl">{emoji}</div>
    <div class="flex-1">
      <h3 class="text-xl font-bold text-slate-900">{title}</h3>
      <p class="text-sm text-brand-700 font-medium mt-0.5">{client}</p>
    </div>
  </div>
  <p class="text-sm text-slate-600 leading-relaxed mb-4">{description}</p>
  <blockquote class="text-sm text-brand-900 italic border-l-4 border-brand-400 pl-4 py-1 bg-white/60 rounded-r">
    "{quote}"
  </blockquote>
</div>
