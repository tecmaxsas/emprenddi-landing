---
interface Props {
  icon: string;
  title: string;
  items: string[];
  accent?: 'brand' | 'emerald' | 'amber' | 'rose' | 'purple';
}

const { icon, title, items, accent = 'brand' } = Astro.props;

const accentClasses = {
  brand:   'bg-brand-100 text-brand-700',
  emerald: 'bg-emerald-100 text-emerald-700',
  amber:   'bg-amber-100 text-amber-700',
  rose:    'bg-rose-100 text-rose-700',
  purple:  'bg-purple-100 text-purple-700',
};
---

<div class="group p-6 rounded-2xl bg-white border border-slate-200/70 hover:border-brand-300 hover:shadow-xl hover:shadow-brand-500/5 transition-all duration-300">
  <div class={`inline-flex w-12 h-12 rounded-xl items-center justify-center text-2xl mb-4 ${accentClasses[accent]}`}>
    {icon}
  </div>
  <h3 class="text-lg font-bold text-slate-900 mb-3">{title}</h3>
  <ul class="space-y-2">
    {items.map((item) => (
      <li class="flex items-start gap-2 text-sm text-slate-600">
        <svg class="w-4 h-4 mt-0.5 text-emerald-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
          <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
        </svg>
        <span set:html={item}></span>
      </li>
    ))}
  </ul>
</div>
