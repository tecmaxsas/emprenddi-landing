---
const year = new Date().getFullYear();
const APP_URL = 'https://pos.emprenddi.com/app';

const cols = [
  {
    title: 'Producto',
    links: [
      { href: '#features', label: 'Funcionalidades' },
      { href: '#casos', label: 'Casos de uso' },
      { href: '/precios', label: 'Precios' },
      { href: '#faq', label: 'Preguntas frecuentes' },
    ],
  },
  {
    title: 'Empresa',
    links: [
      { href: '#about', label: 'Sobre nosotros' },
      { href: 'mailto:comercial@emprenddi.com', label: 'Contacto' },
      { href: '/legal/terminos', label: 'Términos y condiciones' },
      { href: '/legal/privacidad', label: 'Política de privacidad' },
    ],
  },
  {
    title: 'Cuenta',
    links: [
      { href: APP_URL + '/register', label: 'Empezar gratis' },
      { href: APP_URL + '/login', label: 'Iniciar sesión' },
      { href: APP_URL + '/password-reset/request', label: 'Olvidé mi contraseña' },
    ],
  },
];
---

<footer class="bg-slate-900 text-slate-300">
  <div class="container-narrow py-14">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10">
      <!-- Brand -->
      <div>
        <img src="/logos/logo_emprenddi_sin_fondo_blanco.png" alt="Emprenddi" class="h-10 w-auto mb-3" />
        <p class="text-sm leading-relaxed text-slate-400">
          La plataforma todo-en-uno que tu negocio en Colombia necesita.
          Vende, controla tu inventario, lleva tu contabilidad y factura
          a la DIAN — en un solo lugar.
        </p>
      </div>

      <!-- Cols -->
      {cols.map(({ title, links }) => (
        <div>
          <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">{title}</h3>
          <ul class="space-y-2.5">
            {links.map(({ href, label }) => (
              <li>
                <a href={href} class="text-sm text-slate-400 hover:text-white transition">{label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Bottom -->
    <div class="mt-12 pt-8 border-t border-slate-800 flex flex-col sm:flex-row gap-4 justify-between items-center text-sm text-slate-500">
      <div>
        © {year} Emprenddi · Hecho en Colombia 🇨🇴
      </div>
      <div class="flex items-center gap-4">
        <span>Facturación electrónica autorizada DIAN</span>
      </div>
    </div>
  </div>
</footer>
