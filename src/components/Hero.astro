---
const APP_URL = 'https://pos.emprenddi.com/app';
---

<section class="relative overflow-hidden bg-hero-gradient text-white">
  <!-- Blobs decorativos -->
  <div class="absolute top-0 right-0 w-[500px] h-[500px] rounded-full blur-3xl opacity-20 bg-white pointer-events-none"
       style="transform: translate(30%, -30%);"></div>
  <div class="absolute bottom-0 left-0 w-[400px] h-[400px] rounded-full blur-3xl opacity-15 bg-accent-500 pointer-events-none"
       style="transform: translate(-30%, 30%);"></div>

  <div class="container-narrow relative py-20 sm:py-28 lg:py-36">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <!-- Texto -->
      <div class="animate-fade-in-up">
        <span class="inline-block px-3 py-1 mb-6 rounded-full bg-white/15 backdrop-blur text-xs font-bold uppercase tracking-widest border border-white/20">
          Para PyMEs colombianas
        </span>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-[1.1]">
          Tu negocio,<br />
          <span class="relative">
            <span class="bg-gradient-to-r from-amber-300 to-pink-300 bg-clip-text text-transparent">
              bajo control.
            </span>
          </span>
        </h1>
        <p class="mt-6 text-lg sm:text-xl text-white/90 max-w-xl leading-relaxed">
          Vende, controla tu inventario, lleva tu contabilidad y factura a la
          DIAN — todo en una sola plataforma. Sin instalar nada.
          <strong class="text-white">En 5 minutos estás operando.</strong>
        </p>

        <!-- CTAs -->
        <div class="mt-8 flex flex-col sm:flex-row gap-3">
          <a href={APP_URL + '/register'} class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-full bg-white hover:bg-slate-50 text-brand-700 font-bold text-base shadow-xl hover:shadow-2xl transition-all duration-200">
            Empieza gratis 30 días
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
            </svg>
          </a>
          <a href="#features" class="btn-outline justify-center">
            Ver funcionalidades
          </a>
        </div>

        <!-- Trust signals -->
        <div class="mt-10 flex flex-wrap gap-x-8 gap-y-3 text-sm text-white/80">
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-emerald-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
            </svg>
            Sin tarjeta de crédito
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-emerald-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
            </svg>
            Configuración automática
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-emerald-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
            </svg>
            DIAN integrado
          </div>
        </div>
      </div>

      <!-- Mockup visual con cards flotantes -->
      <div class="hidden lg:block relative animate-fade-in-up" style="animation-delay: 200ms;">
        <!-- Card base: dashboard mockup -->
        <div class="relative bg-white rounded-2xl shadow-2xl p-6 text-slate-900 animate-float">
          <div class="flex items-center gap-2 mb-4 pb-3 border-b border-slate-100">
            <div class="w-3 h-3 rounded-full bg-red-400"></div>
            <div class="w-3 h-3 rounded-full bg-yellow-400"></div>
            <div class="w-3 h-3 rounded-full bg-green-400"></div>
            <div class="ml-2 text-xs font-mono text-slate-400">pos.emprenddi.com</div>
          </div>

          <div class="text-xs font-bold text-slate-500 uppercase tracking-wider">Ventas del día</div>
          <div class="mt-2 flex items-baseline gap-2">
            <div class="text-3xl font-extrabold text-brand-700">$2.847.500</div>
            <span class="text-xs font-semibold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-full">+18%</span>
          </div>

          <div class="grid grid-cols-3 gap-3 mt-5">
            <div class="bg-slate-50 rounded-lg p-3">
              <div class="text-[10px] font-bold text-slate-500 uppercase">Tickets</div>
              <div class="text-lg font-bold mt-1">142</div>
            </div>
            <div class="bg-slate-50 rounded-lg p-3">
              <div class="text-[10px] font-bold text-slate-500 uppercase">Ticket prom.</div>
              <div class="text-lg font-bold mt-1">$20K</div>
            </div>
            <div class="bg-slate-50 rounded-lg p-3">
              <div class="text-[10px] font-bold text-slate-500 uppercase">Top</div>
              <div class="text-lg font-bold mt-1">Pizza</div>
            </div>
          </div>

          <div class="mt-4 h-20 rounded-lg bg-gradient-to-r from-brand-100 via-accent-500/20 to-brand-100 relative overflow-hidden">
            <svg class="absolute inset-0 w-full h-full" viewBox="0 0 200 60" preserveAspectRatio="none">
              <path d="M 0 50 Q 30 20 50 30 T 100 25 T 150 15 T 200 20" stroke="#6366f1" stroke-width="2" fill="none" />
              <path d="M 0 50 Q 30 20 50 30 T 100 25 T 150 15 T 200 20 L 200 60 L 0 60 Z" fill="url(#grad)" opacity="0.3" />
              <defs>
                <linearGradient id="grad" x1="0%" y1="0%" x2="0%" y2="100%">
                  <stop offset="0%" stop-color="#6366f1" />
                  <stop offset="100%" stop-color="#6366f1" stop-opacity="0" />
                </linearGradient>
              </defs>
            </svg>
          </div>
        </div>

        <!-- Card flotante 1 -->
        <div class="absolute -top-6 -right-4 bg-white rounded-xl shadow-xl p-3 text-slate-900 animate-float" style="animation-delay: 1s;">
          <div class="flex items-center gap-2">
            <div class="w-8 h-8 rounded-full bg-emerald-100 flex items-center justify-center text-emerald-600">✓</div>
            <div>
              <div class="text-xs font-bold">Factura DIAN</div>
              <div class="text-[10px] text-slate-500">Aceptada · CUFE 9a8b…</div>
            </div>
          </div>
        </div>

        <!-- Card flotante 2 -->
        <div class="absolute -bottom-6 -left-6 bg-white rounded-xl shadow-xl p-3 text-slate-900 animate-float" style="animation-delay: 2s;">
          <div class="flex items-center gap-2">
            <div class="w-8 h-8 rounded-full bg-amber-100 flex items-center justify-center text-amber-600">📦</div>
            <div>
              <div class="text-xs font-bold">Stock bajo</div>
              <div class="text-[10px] text-slate-500">3 productos por debajo del mínimo</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Wave divider -->
  <div class="relative h-12 -mb-px">
    <svg class="absolute bottom-0 left-0 w-full h-full" viewBox="0 0 1440 48" preserveAspectRatio="none">
      <path d="M0,48 L0,24 Q360,0 720,24 T1440,24 L1440,48 Z" fill="white"/>
    </svg>
  </div>
</section>
