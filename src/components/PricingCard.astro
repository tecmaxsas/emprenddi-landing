---
interface Props {
  name: string;
  tagline: string;
  price: string;
  period?: string;
  features: string[];
  ctaLabel: string;
  ctaUrl: string;
  highlighted?: boolean;
  badge?: string;
}

const {
  name,
  tagline,
  price,
  period = '/mes',
  features,
  ctaLabel,
  ctaUrl,
  highlighted = false,
  badge,
} = Astro.props;
---

<div class={`relative p-7 rounded-2xl border-2 ${
  highlighted
    ? 'bg-gradient-to-br from-brand-600 to-purple-600 text-white border-transparent shadow-2xl shadow-brand-500/30 scale-105'
    : 'bg-white text-slate-900 border-slate-200 hover:border-brand-300 hover:shadow-xl'
} transition-all duration-300`}>
  {badge && (
    <span class={`absolute -top-3 left-1/2 -translate-x-1/2 px-4 py-1 rounded-full text-xs font-bold uppercase tracking-wider ${
      highlighted ? 'bg-amber-300 text-amber-900' : 'bg-brand-600 text-white'
    }`}>
      {badge}
    </span>
  )}

  <div class="mb-5">
    <h3 class={`text-xl font-bold ${highlighted ? 'text-white' : 'text-slate-900'}`}>{name}</h3>
    <p class={`text-sm mt-1 ${highlighted ? 'text-white/85' : 'text-slate-500'}`}>{tagline}</p>
  </div>

  <div class="mb-6">
    <div class="flex items-baseline gap-1">
      <span class={`text-4xl font-extrabold ${highlighted ? 'text-white' : 'text-slate-900'}`}>{price}</span>
      <span class={`text-sm ${highlighted ? 'text-white/80' : 'text-slate-500'}`}>{period}</span>
    </div>
  </div>

  <ul class="space-y-3 mb-7">
    {features.map((feature) => (
      <li class="flex items-start gap-2 text-sm">
        <svg class={`w-5 h-5 flex-shrink-0 ${highlighted ? 'text-amber-300' : 'text-emerald-500'}`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
        </svg>
        <span class={highlighted ? 'text-white/90' : 'text-slate-700'} set:html={feature}></span>
      </li>
    ))}
  </ul>

  <a
    href={ctaUrl}
    class={`block text-center px-5 py-3 rounded-full font-bold transition ${
      highlighted
        ? 'bg-white text-brand-700 hover:bg-slate-50 shadow-lg'
        : 'bg-brand-600 hover:bg-brand-700 text-white shadow-md'
    }`}
  >
    {ctaLabel}
  </a>
</div>
